# 这是示例配置，复制为 .env 后按需修改（.env 不会被提交到 git）
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
MAA_REMOTE_SECRET_KEY=change-me-please-use-a-long-random-string

# 数据库，默认使用容器内 SQLite；也可以换成 PostgreSQL，例如：
# MAA_REMOTE_DATABASE_URL=postgresql+psycopg://maa:maa@db:5432/maa
MAA_REMOTE_DATABASE_URL=sqlite:////app/data/maa-remote.db

# 数据目录（数据库、截图都放在这里，需要挂载为持久化卷）
MAA_REMOTE_DATA_DIR=/app/data

# 对外开放的访问地址，用于在网页上展示给用户填到 MAA 里的端点
MAA_REMOTE_PUBLIC_BASE_URL=https://maa.example.com

# 是否允许新用户注册（false 表示只能由管理员手动建号）
MAA_REMOTE_ALLOW_REGISTRATION=true

# 会话有效期（秒），默认 14 天
MAA_REMOTE_SESSION_MAX_AGE=1209600

# 单次上报的最大体积（MB）。截图任务会把整张图以 Base64 上传，务必够大
MAA_REMOTE_MAX_PAYLOAD_MB=64

# 日志级别
MAA_REMOTE_LOG_LEVEL=INFO
